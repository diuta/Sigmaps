# Salin file ini jadi ".env" (atau ".env.local"), lalu isi nilai aslinya.
# JANGAN pernah isi nilai asli di file INI (.env.example) — file ini yang di-commit ke git.
# Lihat CLAUDE.md bagian "Environment variable & secret" untuk aturan lengkap.

# --- Server-only (JANGAN pernah pakai prefix NEXT_PUBLIC_) ---

# MAPID Competition API (Struk Go/Menu Go/Properti Go/Activities) — header x-api-key
MAPID_API_KEY=

# Supabase — project settings > API > "service_role" / "secret" key
# Key ini punya akses PENUH ke database, TIDAK BOLEH bocor ke browser
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase — connection string PostgreSQL langsung.
# HANYA dipakai pipeline batch Python di etl/, TIDAK dipakai Next.js.
# Ambil di: Settings > Database > Connection string > URI, pilih "Session pooler"
# (bukan "Direct connection" — itu butuh IPv6 yang jarang tersedia di Indonesia).
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Passwordnya password DATABASE, bukan service role key.
DATABASE_URL=

# Google Gemini (via Google AI Studio) — dipakai lewat Vercel AI SDK di app/api/*
GEMINI_API_KEY=

# --- Public (SENGAJA dibundel ke browser, aman dilihat siapa saja) ---

# MAPID MAPS (basemap) — Map Services > API Keys di dashboard GEO MAPID
NEXT_PUBLIC_MAPID_MAPS_KEY=
