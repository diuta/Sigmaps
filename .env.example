# Salin file ini jadi .env.local dan isi nilainya. Jangan pernah commit nilai asli
# (CLAUDE.md bagian "Environment variable & secret").

# --- Server-only (tanpa prefix NEXT_PUBLIC_) ---

# Google AI Studio (Gemini), dipakai lib/ai/gemini.ts
GEMINI_API_KEY=

# Override nama model tanpa ubah kode (opsional, Google merotasi model cepat)
GEMINI_MODEL_FLASH_LITE=
GEMINI_MODEL_FLASH=

# MAPID Competition API (Properti Go/Struk Go/Menu Go/Activities), dipakai etl/script.py
MAPID_API_KEY=

# Supabase (PostgreSQL + PostGIS), dipakai lib/supabase/server.ts
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Public (prefix NEXT_PUBLIC_ wajib, sengaja dibundel ke browser) ---

# Basemap MAPID MAPS, dipakai components/map/BaseMap.tsx.
# NAMA HARUS BEDA dari MAPID_API_KEY di atas walau nilainya boleh sama persis (satu key
# MAPID dipakai untuk basemap + Competition API) — kalau nama disatukan jadi satu variabel
# ber-prefix NEXT_PUBLIC_, key Competition API-nya ikut bocor ke browser (CLAUDE.md #4).
NEXT_PUBLIC_MAPID_MAPS_KEY=
